{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "Common definitions",
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "dice": {
      "type": "string",
      "pattern": "^[0-9]+d[0-9]+([+-][0-9]+)?$",
      "description": "Dice notation, e.g. 1d6, 2d4+1"
    },
    "stats": {
      "type": "object",
      "required": ["strength", "dexterity", "intelligence", "constitution"],
      "properties": {
        "strength": { "type": "integer" },
        "dexterity": { "type": "integer" },
        "intelligence": { "type": "integer" },
        "constitution": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "statMods": {
      "type": "object",
      "properties": {
        "strength": { "type": "integer" },
        "dexterity": { "type": "integer" },
        "intelligence": { "type": "integer" },
        "constitution": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "point": {
      "type": "object",
      "required": ["x", "y"],
      "properties": { "x": { "type": "integer", "minimum": 0 }, "y": { "type": "integer", "minimum": 0 } }
    },
    "facing": { "enum": ["n", "e", "s", "w"] },
    "color": { "type": "integer", "minimum": 0, "maximum": 15, "description": "TMS9918A palette index" }
  }
}
