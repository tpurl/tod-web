{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "party.schema.json",
  "title": "Party",
  "type": "object",
  "required": ["members", "gold", "food", "depth", "position", "facing"],
  "properties": {
    "members": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "$ref": "character.schema.json" } },
    "gold": { "type": "integer", "minimum": 0 },
    "food": { "type": "integer", "minimum": 0 },
    "depth": { "type": "integer", "minimum": 1, "description": "Current floor, 1 = top" },
    "position": { "$ref": "common.schema.json#/$defs/point" },
    "facing": { "$ref": "common.schema.json#/$defs/facing" },
    "stepsTaken": { "type": "integer", "minimum": 0 },
    "questFlags": { "type": "object", "additionalProperties": { "type": ["boolean", "integer", "string"] } }
  }
}
